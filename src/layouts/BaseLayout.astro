---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = "Open-source and local AI tools directory tested for offline runs, hardware specs, and privacy.",
  ogType = 'website',
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://libreaideck.com')).toString().replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageURL = `${siteOrigin}/og-image.svg`;
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-TQPTL76R"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="JPLSqONrld2-oFmc7LMo2gUkmNwuyz6TsnBY-8wSid0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content="LibreAIDeck" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased overflow-x-hidden">
    <header class="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 py-2.5 md:py-0 md:h-14 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
        <div class="flex items-center justify-between">
          <a href="/" class="font-bold text-white tracking-tight flex items-center gap-2 shrink-0">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>LibreAIDeck</span>
          </a>
          <a href="/can-i-run-it/" class="md:hidden text-xs font-semibold px-2.5 py-1 rounded-md bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 whitespace-nowrap">
            Can I Run It?
          </a>
        </div>
        <nav aria-label="Primary Navigation" class="flex items-center gap-3.5 sm:gap-4 text-xs sm:text-sm text-slate-300 overflow-x-auto pb-1 md:pb-0">
          <a href="/" class="hover:text-white transition whitespace-nowrap shrink-0">Directory</a>
          <a href="/best-offline-ai-tools/" class="hover:text-white transition whitespace-nowrap shrink-0">All Tools (62)</a>
          <a href="/vram/cpu-only" class="hover:text-white transition whitespace-nowrap shrink-0">CPU-Only</a>
          <a href="/vram/8gb" class="hover:text-white transition whitespace-nowrap shrink-0">≤8GB VRAM</a>
          <a href="/alternatives/" class="text-emerald-400 hover:text-emerald-300 font-medium transition whitespace-nowrap shrink-0">Alternatives</a>
          <a href="/compare/" class="hover:text-white transition whitespace-nowrap shrink-0">Compare</a>
          <a href="/can-i-run-it/" class="hidden md:inline-block font-medium text-emerald-400 hover:text-emerald-300 transition whitespace-nowrap shrink-0">Can I Run It?</a>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-6 sm:py-8 overflow-x-hidden">
      <slot />
    </main>

    <footer class="border-t border-slate-800 mt-16 py-8 text-center text-xs text-slate-400">
      <div class="max-w-6xl mx-auto px-4">
        LibreAIDeck.com — Local &amp; Open-Source AI Directory<br /><span class="text-[11px] text-slate-500 mt-1 inline-block">As an Amazon Associate I earn from qualifying purchases.</span>
      </div>
    </footer>
  </body>
</html>
