---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((entry) => {
    const tool = entry.data;
    const relatedTools = tools
      .map((other) => other.data)
      .filter((other) => other.slug !== tool.slug)
      .sort((a, b) => {
        const aSameCat = a.category === tool.category ? 2 : 0;
        const bSameCat = b.category === tool.category ? 2 : 0;
        const aSharedAlt = a.alternative_to.some((alt) => tool.alternative_to.includes(alt)) ? 1 : 0;
        const bSharedAlt = b.alternative_to.some((alt) => tool.alternative_to.includes(alt)) ? 1 : 0;
        return bSameCat + bSharedAlt - (aSameCat + aSharedAlt);
      })
      .slice(0, 4);

    return {
      params: { slug: tool.slug },
      props: { tool, relatedTools },
    };
  });
}

const { tool, relatedTools } = Astro.props;
const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const siteUrl = (Astro.site ?? new URL("https://libreaideck.com")).toString().replace(/\/$/, "");
const pageUrl = `${siteUrl}/tool/${tool.slug}`;
const primaryAlt = tool.alternative_to[0];
const allAlts = tool.alternative_to.join(", ");

const vramText = tool.min_vram_gb === 0
  ? `CPU-Only (${tool.min_ram_gb}GB RAM)`
  : `${tool.min_vram_gb}GB VRAM`;

const seoTitle = tool.min_vram_gb === 0
  ? `${tool.name} (2026): CPU-Only Offline ${tool.category} AI (${tool.min_ram_gb}GB RAM)`
  : `${tool.name} (2026): ${tool.min_vram_gb}GB VRAM Offline ${tool.category} AI`;

const seoDescription = `${tool.tagline} Runs 100% offline (${vramText}, ${tool.license}). Free local alternative to ${allAlts || "cloud AI"} with real test notes.`;

const faqList = [
  {
    q: `How much VRAM and RAM does ${tool.name} require?`,
    a: tool.min_vram_gb === 0
      ? `${tool.name} runs on CPU without a dedicated GPU and requires at least ${tool.min_ram_gb} GB of system RAM.`
      : `${tool.name} requires a minimum of ${tool.min_vram_gb} GB VRAM and ${tool.min_ram_gb} GB of system RAM for local inference.`,
  },
  {
    q: `Does ${tool.name} work completely offline without an account?`,
    a: `${tool.runs_offline ? "Yes" : "No"}, ${tool.name} operates ${tool.runs_offline ? "100% offline on local hardware" : "with network access"} and ${tool.requires_signup ? "requires account sign-up" : "requires no sign-up or cloud API keys"}.`,
  },
  {
    q: `Can I use ${tool.name} commercially as a free alternative to ${primaryAlt || "paid AI"}?`,
    a: `${tool.name} is licensed under ${tool.license}${tool.commercial_use ? " and allows commercial use" : ""}. It serves as a self-hosted alternative to ${allAlts || "subscription AI tools"}.`,
  },
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.name,
  description: tool.tagline,
  applicationCategory: `${tool.category}Application`,
  operatingSystem: tool.platforms.join(", "),
  license: tool.license,
  memoryRequirements: `${tool.min_ram_gb} GB RAM${tool.min_vram_gb > 0 ? `, ${tool.min_vram_gb} GB VRAM` : " (CPU supported)"}`,
  dateModified: tool.last_verified,
  url: pageUrl,
  sameAs: [tool.official_url, tool.github_repo ? `https://github.com/${tool.github_repo}` : null].filter(Boolean),
  featureList: tool.pros,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqList.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Directory",
    item: `${siteUrl}/`,
  },
  ...(primaryAlt
    ? [
        {
          "@type": "ListItem",
          position: 2,
          name: `${primaryAlt} Alternatives`,
          item: `${siteUrl}/alternatives/${toSlug(primaryAlt)}`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: tool.name,
          item: pageUrl,
        },
      ]
    : [
        {
          "@type": "ListItem",
          position: 2,
          name: tool.name,
          item: pageUrl,
        },
      ]),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-sm text-slate-400">
    <a href="/" class="text-emerald-400 hover:text-emerald-300">Directory</a>
    {primaryAlt && (
      <>
        <span>/</span>
        <a href={`/alternatives/${toSlug(primaryAlt)}`} class="hover:text-slate-200">
          {primaryAlt} Alternatives
        </a>
      </>
    )}
    <span>/</span>
    <span class="text-slate-200">{tool.name}</span>
  </nav>

  <article class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 space-y-8">
    <header class="border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-start md:justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            {tool.category}
          </span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300">
            {tool.pricing_model} · {tool.license}
          </span>
          <span class="text-xs text-slate-400">Verified: {tool.last_verified}</span>
        </div>
        <h1 class="text-3xl font-bold text-white mb-2">{tool.name}</h1>
        <p class="text-slate-300 max-w-3xl">{tool.tagline}</p>
      </div>

      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href={tool.official_url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition"
        >
          Official Site
        </a>
        {tool.github_repo && (
          <a
            href={`https://github.com/${tool.github_repo}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-sm transition"
          >
            GitHub
          </a>
        )}
      </div>
    </header>

    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
        <div class="text-xs text-slate-400 mb-1">Min VRAM</div>
        <div class="text-lg font-semibold text-white">{tool.min_vram_gb} GB</div>
      </div>
      <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
        <div class="text-xs text-slate-400 mb-1">Min RAM</div>
        <div class="text-lg font-semibold text-white">{tool.min_ram_gb} GB</div>
      </div>
      <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
        <div class="text-xs text-slate-400 mb-1">Runs Offline</div>
        <div class="text-lg font-semibold text-white">{tool.runs_offline ? "Yes" : "No"}</div>
      </div>
      <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
        <div class="text-xs text-slate-400 mb-1">Sign-up / Watermark</div>
        <div class="text-sm font-semibold text-white">
          {tool.requires_signup ? "Sign-up req." : "No sign-up"} · {tool.has_watermark ? "Watermark" : "No watermark"}
        </div>
      </div>
    </section>

    <aside class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4 my-6">
      <div class="text-sm">
        <div class="font-semibold text-white mb-0.5">
          {tool.min_vram_gb === 0
            ? `Hardware Setup: Runs on CPU (${tool.min_ram_gb}GB+ System RAM)`
            : `Hardware Setup: Requires ${tool.min_vram_gb}GB+ VRAM`}
        </div>
        <p class="text-xs text-slate-400">
          {tool.min_vram_gb === 0
            ? "No discrete GPU required. Smooth batch runs with a 32GB RAM upgrade or an energy-efficient Mini PC."
            : "Upgrade your local rig for unlimited offline runs, or rent an on-demand cloud GPU by the hour."}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a
          href={tool.min_vram_gb === 0 ? "/vram/cpu-only" : tool.min_vram_gb <= 4 ? "/vram/4gb" : tool.min_vram_gb <= 6 ? "/vram/6gb" : "/vram/8gb"}
          class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition"
        >
          {tool.min_vram_gb === 0 ? "More CPU-Only AI" : `More ≤${tool.min_vram_gb <= 8 ? tool.min_vram_gb : 8}GB Tools`}
        </a>
        <a
          href={tool.min_vram_gb === 0
            ? `https://www.amazon.com/s?k=32GB+DDR5+RAM+kit&tag=libreaideck-20`
            : `https://www.amazon.com/s?k=RTX+3060+12GB&tag=libreaideck-20`}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="px-3 py-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 text-xs font-medium transition"
        >
          {tool.min_vram_gb === 0 ? "Check 32GB RAM Price →" : "Check RTX 3060 12GB →"}
        </a>
        {tool.min_vram_gb > 0 && (
          <a
            href="https://runpod.io?ref=xhjwok0s"
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 text-xs font-medium transition"
          >
            Rent Cloud GPU →
          </a>
        )}
      </div>
    </aside>

    <section class="bg-slate-950/70 border border-slate-800 rounded-xl p-5">
      <h2 class="text-lg font-semibold text-white mb-2">Real-World Test Summary</h2>
      <p class="text-slate-300 leading-relaxed">{tool.real_test_summary}</p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-5">
        <h2 class="text-base font-semibold text-emerald-400 mb-3">Pros</h2>
        <ul class="space-y-2 text-sm text-slate-300 list-disc list-inside">
          {tool.pros.map((pro) => <li>{pro}</li>)}
        </ul>
      </div>
      <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-5">
        <h2 class="text-base font-semibold text-amber-400 mb-3">Cons</h2>
        <ul class="space-y-2 text-sm text-slate-300 list-disc list-inside">
          {tool.cons.map((con) => <li>{con}</li>)}
        </ul>
      </div>
    </section>

    <section class="pt-4 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4 text-sm">
      <div>
        <span class="text-slate-400 mr-2">Platforms:</span>
        <span class="text-slate-200">{tool.platforms.join(", ")}</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-slate-400">Alternative to:</span>
        {tool.alternative_to.map((alt) => (
          <a
            href={`/alternatives/${toSlug(alt)}`}
            class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs"
          >
            {alt}
          </a>
        ))}
      </div>
    </section>
  </article>

  <section class="mt-10 bg-slate-900/70 border border-slate-800 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">
      {tool.name} Hardware &amp; Licensing FAQ
    </h2>
    <div class="space-y-4">
      {faqList.map((item) => (
        <div class="border-b border-slate-800/80 last:border-none pb-3 last:pb-0">
          <h3 class="text-sm font-semibold text-slate-200 mb-1">{item.q}</h3>
          <p class="text-sm text-slate-400">{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  {relatedTools.length > 0 && (
    <section class="mt-10">
      <h2 class="text-lg font-semibold text-white mb-4">
        Related Local &amp; Open-Source {tool.category} Tools
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {relatedTools.map((rel) => (
          <article class="rounded-xl border border-slate-800 bg-slate-900/70 p-4 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span class="text-emerald-400 font-medium">{rel.category}</span>
                <span>VRAM: {rel.min_vram_gb} GB · RAM: {rel.min_ram_gb} GB</span>
              </div>
              <h3 class="text-base font-semibold text-white mb-1">
                <a href={`/tool/${rel.slug}`} class="hover:text-emerald-400 transition">
                  {rel.name}
                </a>
              </h3>
              <p class="text-xs text-slate-300 mb-3">{rel.tagline}</p>
            </div>
            <a href={`/tool/${rel.slug}`} class="text-xs font-medium text-emerald-400 hover:text-emerald-300">
              View {rel.name} specs →
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
