---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

function toSlug(input: unknown): string {
  return String(input ?? "")
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

export async function getStaticPaths() {
  const slugify = (input: unknown): string =>
    String(input ?? "")
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const tools = await getCollection("tools");
  const paidToolMap = new Map<string, string>();

  for (const entry of tools) {
    const alts = Array.isArray(entry.data.alternative_to ?? entry.data.alternatives_to ?? entry.data.replaces)
      ? (entry.data.alternative_to ?? entry.data.alternatives_to ?? entry.data.replaces)
      : [];
    for (const alt of alts) {
      const slug = slugify(alt);
      if (slug && !paidToolMap.has(slug)) {
        paidToolMap.set(slug, String(alt));
      }
    }
  }

  return Array.from(paidToolMap.entries()).map(([paid_tool, paidToolName]) => {
    const matchingTools = tools
      .filter((entry) => {
        const alts = Array.isArray(entry.data.alternative_to ?? entry.data.alternatives_to ?? entry.data.replaces)
          ? (entry.data.alternative_to ?? entry.data.alternatives_to ?? entry.data.replaces)
          : [];
        return alts.some((alt) => slugify(alt) === paid_tool);
      })
      .sort((a, b) => a.data.min_vram_gb - b.data.min_vram_gb);

    return {
      params: { paid_tool },
      props: { paidToolName, matchingTools },
    };
  });
}

const { paid_tool } = Astro.params;
const { paidToolName, matchingTools } = Astro.props;
const siteUrl = (Astro.site ?? new URL("https://libreaideck.com")).toString().replace(/\/$/, "");
const pageUrl = `${siteUrl}/alternatives/${paid_tool}`;

const count = matchingTools.length;
const lowestVram = count > 0 ? Math.min(...matchingTools.map((t) => t.data.min_vram_gb)) : 0;
const vramHook = lowestVram === 0 ? "CPU-Only & GPU" : `From ${lowestVram}GB VRAM`;
const topNames = matchingTools.slice(0, 3).map((t) => t.data.name).join(", ");

const seoTitle = `${count} Best Free & Local Alternatives to ${paidToolName} (2026)`;
const pageDescription = `Compare ${count} open-source and offline alternatives to ${paidToolName} (${vramHook}), including ${topNames}. Full VRAM, RAM, and license specs.`;

const alternativesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seoTitle,
  description: pageDescription,
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: count,
    itemListElement: matchingTools.map((entry, index) => {
      const slug = entry.data.slug ?? entry.slug ?? toSlug(entry.data.name ?? entry.id);
      return {
        "@type": "ListItem",
        position: index + 1,
        name: entry.data.name,
        url: `${siteUrl}/tool/${slug}`,
      };
    }),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Directory", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: `${paidToolName} Alternatives`, item: pageUrl },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(alternativesSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-sm text-slate-400">
    <a href="/" class="text-emerald-400 hover:text-emerald-300">Directory</a>
    <span>/</span>
    <span class="text-slate-200">{paidToolName} Alternatives</span>
  </nav>

  <section class="mb-8">
    <p class="text-sm text-emerald-400 font-medium mb-2">
      {count} Verified Local &amp; Open-Source Options · {vramHook}
    </p>
    <h1 class="text-3xl font-bold tracking-tight mb-2">
      Best Free &amp; Local Alternatives to {paidToolName} (2026)
    </h1>
    <p class="text-slate-300 max-w-3xl">
      Compare self-hosted and offline tools that replace {paidToolName} without subscriptions, sorted from lowest to highest VRAM requirements.
    </p>
  </section>

  {count > 1 && (
    <section class="mb-10 overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/50">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-800 bg-slate-900 text-xs uppercase text-slate-400">
          <tr>
            <th class="px-4 py-3">Tool</th>
            <th class="px-4 py-3">Min VRAM</th>
            <th class="px-4 py-3">Min RAM</th>
            <th class="px-4 py-3">License</th>
            <th class="px-4 py-3">Offline</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/80 text-slate-300">
          {matchingTools.map((entry) => {
            const d = entry.data;
            const slug = d.slug ?? entry.slug ?? toSlug(d.name ?? entry.id);
            return (
              <tr class="hover:bg-slate-800/40 transition">
                <td class="px-4 py-3 font-medium text-white">
                  <a href={`/tool/${slug}`} class="hover:text-emerald-400">{d.name}</a>
                </td>
                <td class="px-4 py-3">{d.min_vram_gb === 0 ? "0 GB (CPU)" : `${d.min_vram_gb} GB`}</td>
                <td class="px-4 py-3">{d.min_ram_gb} GB</td>
                <td class="px-4 py-3">{d.license}</td>
                <td class="px-4 py-3 text-emerald-400">{d.runs_offline ? "Yes" : "No"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>
  )}

  <div class="grid gap-4 md:grid-cols-2">
    {matchingTools.map((entry) => {
      const data = entry.data;
      const slug = data.slug ?? entry.slug ?? toSlug(data.name ?? entry.id);
      return (
        <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
              <span class="text-emerald-400 font-medium">{data.category}</span>
              <span>{data.license}</span>
            </div>
            <h2 class="text-xl font-semibold mb-1">
              <a href={`/tool/${slug}`} class="hover:text-emerald-400 transition">{data.name}</a>
            </h2>
            <p class="text-sm text-slate-300 mb-4">{data.tagline}</p>
          </div>

          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <span>
              Min VRAM: <strong class="text-slate-200">{data.min_vram_gb} GB</strong> · RAM:{" "}
              <strong class="text-slate-200">{data.min_ram_gb} GB</strong>
            </span>
            <a href={`/tool/${slug}`} class="text-sm font-medium text-emerald-400 hover:text-emerald-300">
              View Spec →
            </a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
