---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

function toSlug(input: unknown): string {
  return String(input ?? "")
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

export async function getStaticPaths() {
  const slugify = (input: unknown): string =>
    String(input ?? "")
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const tools = await getCollection("tools");
  const paidToolMap = new Map<string, string>();

  for (const entry of tools) {
    const alts = entry.data.alternatives_to ?? entry.data.replaces ?? [];
    if (Array.isArray(alts)) {
      for (const alt of alts) {
        const slug = slugify(alt);
        if (slug && !paidToolMap.has(slug)) {
          paidToolMap.set(slug, String(alt));
        }
      }
    }
  }

  return Array.from(paidToolMap.entries()).map(([paid_tool, paidToolName]) => {
    const matchingTools = tools.filter((entry) => {
      const alts = entry.data.alternatives_to ?? entry.data.replaces ?? [];
      return Array.isArray(alts) && alts.some((alt) => slugify(alt) === paid_tool);
    });

    return {
      params: { paid_tool },
      props: { paidToolName, matchingTools },
    };
  });
}

const { paidToolName, matchingTools } = Astro.props;
---

<BaseLayout title={`${paidToolName} Open-Source Alternatives | LibreAIDeck`}>
  <section class="mb-8">
    <p class="text-sm text-emerald-400 font-medium mb-2">Open-Source Alternatives</p>
    <h1 class="text-3xl font-bold tracking-tight mb-2">
      Best Self-Hosted &amp; Open-Source Alternatives to {paidToolName}
    </h1>
    <p class="text-slate-300">
      Compare local and open-source tools that can replace {paidToolName}, including hardware and VRAM requirements.
    </p>
  </section>

  <div class="grid gap-4 md:grid-cols-2">
    {matchingTools.map((entry) => {
      const data = entry.data;
      const slug = data.slug ?? entry.slug ?? toSlug(data.name ?? entry.id);
      return (
        <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 flex flex-col justify-between">
          <div>
            <h2 class="text-xl font-semibold mb-1">
              <a href={`/tool/${slug}`} class="hover:text-emerald-400 transition">{data.name}</a>
            </h2>
            <p class="text-sm text-slate-300 mb-4">{data.tagline}</p>
          </div>

          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <span>
              Min VRAM: <strong class="text-slate-200">{data.min_vram_gb} GB</strong> · RAM:{" "}
              <strong class="text-slate-200">{data.min_ram_gb} GB</strong>
            </span>
            <a href={`/tool/${slug}`} class="text-sm font-medium text-emerald-400 hover:text-emerald-300">
              View Spec →
            </a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
