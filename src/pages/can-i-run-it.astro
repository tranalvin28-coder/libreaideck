<BaseLayout title="Can I Run It? Local AI VRAM & Hardware Checker | LibreAIDeck" description="Select your GPU or MacBook specs to instantly filter 62+ offline AI tools that run smoothly on your hardware.">
<main class="max-w-6xl mx-auto px-4 py-10">
  <header class="mb-8">
    <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-3">
      Interactive Hardware Compatibility Checker
    </span>
    <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">
      Can I Run It? Local AI VRAM &amp; MacBook Checker
    </h1>
    <p class="text-slate-400 max-w-3xl text-base md:text-lg">
      Select your GPU or Apple Silicon MacBook below to filter all <strong>62 verified offline AI tools</strong> by exact VRAM and system RAM limits—before downloading multi-gigabyte weights.
    </p>
  </header>

  <!-- Quick Hardware Presets -->
  <section class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2.5">1. Quick Select Your Machine:</p>
    <div class="flex flex-wrap gap-2" id="preset-buttons">
      <button type="button" data-vram="0" data-ram="8" data-label="CPU-Only Laptop (0GB VRAM / 8GB RAM)" class="preset-btn px-3.5 py-2 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
        💻 CPU-Only Laptop (8GB RAM)
      </button>
      <button type="button" data-vram="6" data-ram="16" data-label="MacBook Air M1/M2/M3 (16GB Unified)" class="preset-btn px-3.5 py-2 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
        🍎 MacBook Air M1/M2 (16GB)
      </button>
      <button type="button" data-vram="4" data-ram="16" data-label="Entry Gaming Laptop (RTX 3050 / GTX 1650 4GB)" class="preset-btn px-3.5 py-2 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
        🎮 RTX 3050 / 4GB VRAM
      </button>
      <button type="button" data-vram="8" data-ram="16" data-label="Mid-Range GPU (RTX 4060 / 3070 8GB)" class="preset-btn px-3.5 py-2 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
        ⚡ RTX 4060 / 3070 (8GB VRAM)
      </button>
      <button type="button" data-vram="12" data-ram="32" data-label="Sweet-Spot AI Rig (RTX 3060 / 4070 12GB)" class="preset-btn px-3.5 py-2 rounded-lg text-sm font-medium bg-emerald-600/20 text-emerald-300 border border-emerald-500/50 transition">
        🔥 RTX 3060 / 4070 (12GB VRAM)
      </button>
      <button type="button" data-vram="24" data-ram="64" data-label="Workstation GPU (RTX 3090 / 4090 24GB)" class="preset-btn px-3.5 py-2 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
        🚀 RTX 3090 / 4090 (24GB VRAM)
      </button>
    </div>
  </section>

  <!-- Fine-Tune Sliders & Category Filter -->
  <section class="p-5 rounded-2xl bg-slate-900/90 border border-slate-800 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <div class="flex justify-between text-sm font-medium mb-2">
        <label for="vram-slider">Available GPU VRAM</label>
        <span id="vram-display" class="text-emerald-400 font-bold">12 GB VRAM</span>
      </div>
      <input id="vram-slider" type="range" min="0" max="24" step="2" value="12" class="w-full accent-emerald-500 cursor-pointer" />
      <div class="flex justify-between text-xs text-slate-500 mt-1">
        <span>0GB (CPU)</span><span>6GB</span><span>12GB</span><span>24GB+</span>
      </div>
    </div>

    <div>
      <div class="flex justify-between text-sm font-medium mb-2">
        <label for="ram-slider">System RAM</label>
        <span id="ram-display" class="text-sky-400 font-bold">32 GB RAM</span>
      </div>
      <input id="ram-slider" type="range" min="4" max="64" step="4" value="32" class="w-full accent-sky-500 cursor-pointer" />
      <div class="flex justify-between text-xs text-slate-500 mt-1">
        <span>4GB</span><span>16GB</span><span>32GB</span><span>64GB</span>
      </div>
    </div>

    <div>
      <label for="category-select" class="block text-sm font-medium mb-2">AI Task Category</label>
      <select id="category-select" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-sm focus:outline-none focus:border-emerald-500">
        <option value="ALL">All Categories (62 Tools)</option>
        <option value="LLM">LLM &amp; Chat</option>
        <option value="Image">Image Generation &amp; Upscaling</option>
        <option value="Video">Video Generation</option>
        <option value="Audio">Audio, TTS &amp; Music</option>
        <option value="Agents">AI Agents &amp; Automation</option>
        <option value="Coding">Coding Assistants</option>
      </select>
    </div>
  </section>

  <!-- Summary Banner -->
  <div id="status-banner" class="p-4 rounded-xl bg-slate-900 border border-slate-800 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <p class="text-sm text-slate-400">Active Profile: <strong id="profile-label" class="text-white">RTX 3060 / 4070 (12GB VRAM)</strong></p>
      <p class="text-lg font-bold mt-0.5">
        <span id="compatible-count" class="text-emerald-400">0</span> tools run locally &bull; 
        <span id="heavy-count" class="text-amber-400">0</span> require hardware upgrade or Cloud GPU
      </p>
    </div>
    <div class="flex flex-wrap gap-2.5">
      <a id="amazon-upgrade-btn" href="https://www.amazon.com/s?k=RTX+4070+12GB+GPU&tag=libreaideck-20" target="_blank" rel="sponsored noopener noreferrer" class="px-4 py-2 rounded-lg text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 transition">
        Upgrade GPU on Amazon
      </a>
      <a href="https://runpod.io?ref=xhjwok0s" target="_blank" rel="sponsored noopener noreferrer" class="px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition">
        Rent 24GB GPU on RunPod
      </a>
    </div>
  </div>

  <!-- Compatible Tools Grid -->
  <section class="mb-12">
    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
      Ready to Run Locally on Your Hardware
    </h2>
    <div id="compatible-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </section>

  <!-- Heavy Tools Grid (Monetization Trigger) -->
  <section id="heavy-section" class="hidden">
    <div class="p-5 rounded-2xl bg-amber-500/5 border border-amber-500/20 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-amber-300 flex items-center gap-2">
          <span>⚠️</span> Exceeds Your Current VRAM / RAM
        </h2>
        <p class="text-sm text-slate-400 mt-1">
          Running these models locally may trigger Out-Of-Memory (OOM) errors. Run them instantly on an on-demand cloud GPU or upgrade your local hardware.
        </p>
      </div>
      <a href="https://runpod.io?ref=xhjwok0s" target="_blank" rel="sponsored noopener noreferrer" class="shrink-0 px-4 py-2.5 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition">
        Launch on RunPod ($0.20/hr+) →
      </a>
    </div>
    <div id="heavy-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </section>
</main>

<script define:vars={{ toolsData }}>
  const vramSlider = document.getElementById("vram-slider");
  const ramSlider = document.getElementById("ram-slider");
  const categorySelect = document.getElementById("category-select");
  const vramDisplay = document.getElementById("vram-display");
  const ramDisplay = document.getElementById("ram-display");
  const profileLabel = document.getElementById("profile-label");
  const compatibleCount = document.getElementById("compatible-count");
  const heavyCount = document.getElementById("heavy-count");
  const compatibleGrid = document.getElementById("compatible-grid");
  const heavyGrid = document.getElementById("heavy-grid");
  const heavySection = document.getElementById("heavy-section");
  const amazonBtn = document.getElementById("amazon-upgrade-btn");

  function getAmazonUpgradeUrl(vram, ram) {
    if (ram < 16) return "https://www.amazon.com/s?k=32GB+DDR5+RAM+kit&tag=libreaideck-20";
    if (vram < 8) return "https://www.amazon.com/s?k=RTX+3060+12GB+graphics+card&tag=libreaideck-20";
    if (vram < 16) return "https://www.amazon.com/s?k=RTX+4070+Ti+Super+16GB+GPU&tag=libreaideck-20";
    return "https://www.amazon.com/s?k=RTX+4090+24GB+GPU&tag=libreaideck-20";
  }

  function renderCard(tool, isCompatible) {
    const vramBadge = tool.min_vram_gb === 0
      ? '<span class="px-2 py-0.5 text-xs font-semibold rounded bg-emerald-500/15 text-emerald-300">0GB (CPU-Only)</span>'
      : `<span class="px-2 py-0.5 text-xs font-semibold rounded ${isCompatible ? 'bg-sky-500/15 text-sky-300' : 'bg-amber-500/15 text-amber-300'}">${tool.min_vram_gb}GB VRAM</span>`;

    const actionHtml = isCompatible
      ? `<a href="/tool/${tool.slug}" class="inline-block mt-3 text-sm font-semibold text-emerald-400 hover:text-emerald-300">View Install &amp; Benchmark →</a>`
      : `<div class="mt-3 flex items-center gap-3 text-xs font-semibold">
           <a href="https://runpod.io?ref=xhjwok0s" target="_blank" rel="sponsored noopener noreferrer" class="text-indigo-400 hover:text-indigo-300">Run on RunPod →</a>
           <a href="/tool/${tool.slug}" class="text-slate-400 hover:text-slate-200">Specs</a>
         </div>`;

    return `
      <article class="p-4 rounded-xl bg-slate-900 border ${isCompatible ? 'border-slate-800 hover:border-emerald-500/40' : 'border-amber-500/20'} transition flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-medium text-slate-400">${tool.category}</span>
            <div class="flex items-center gap-1.5">
              ${vramBadge}
              <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">${tool.min_ram_gb}GB RAM</span>
            </div>
          </div>
          <h3 class="text-base font-bold text-white">
            <a href="/tool/${tool.slug}" class="hover:underline">${tool.name}</a>
          </h3>
          <p class="text-xs text-slate-400 mt-1 line-clamp-2">${tool.tagline}</p>
        </div>
        ${actionHtml}
      </article>
    `;
  }

  function updateView() {
    const vram = Number(vramSlider.value);
    const ram = Number(ramSlider.value);
    const cat = categorySelect.value;

    vramDisplay.textContent = vram === 0 ? "0 GB (CPU-Only)" : `${vram} GB VRAM`;
    ramDisplay.textContent = `${ram} GB RAM`;
    amazonBtn.href = getAmazonUpgradeUrl(vram, ram);

    const filtered = toolsData.filter(t => cat === "ALL" || t.category === cat);
    const compatible = filtered.filter(t => t.min_vram_gb <= vram && t.min_ram_gb <= ram);
    const heavy = filtered.filter(t => t.min_vram_gb > vram || t.min_ram_gb > ram);

    compatibleCount.textContent = compatible.length;
    heavyCount.textContent = heavy.length;

    compatibleGrid.innerHTML = compatible.length
      ? compatible.map(t => renderCard(t, true)).join("")
      : '<p class="text-sm text-slate-400 col-span-full">No tools match this exact RAM/VRAM filter. Try increasing System RAM or switching category.</p>';

    if (heavy.length > 0) {
      heavySection.classList.remove("hidden");
      heavyGrid.innerHTML = heavy.map(t => renderCard(t, false)).join("");
    } else {
      heavySection.classList.add("hidden");
    }
  }

  document.querySelectorAll(".preset-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      vramSlider.value = btn.dataset.vram;
      ramSlider.value = btn.dataset.ram;
      profileLabel.textContent = btn.dataset.label;
      document.querySelectorAll(".preset-btn").forEach(b => {
        b.classList.remove("bg-emerald-600/20", "text-emerald-300", "border-emerald-500/50");
        b.classList.add("bg-slate-800", "border-slate-700");
      });
      btn.classList.remove("bg-slate-800", "border-slate-700");
      btn.classList.add("bg-emerald-600/20", "text-emerald-300", "border-emerald-500/50");
      updateView();
    });
  });

  [vramSlider, ramSlider].forEach(el => {
    el.addEventListener("input", () => {
      profileLabel.textContent = `Custom Build (${vramSlider.value}GB VRAM / ${ramSlider.value}GB RAM)`;
      updateView();
    });
  });

  categorySelect.addEventListener("change", updateView);
  updateView();
</script>
</BaseLayout>
